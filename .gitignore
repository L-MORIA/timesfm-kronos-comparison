# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Logs (gitignored, but created at runtime)
# Именно logs/* , а не logs/ : при исключении каталога целиком git не заходит
# внутрь и не может re-include отдельный файл. README с контрактом формата
# логов версионируется — по нему отличаются записи до и после 2026-10-14.
logs/*
!logs/README.md

# Images
*.png
*.jpg
*.jpeg

# OS
.DS_Store
Thumbs.db
# Temporary diagnostic scripts
check_*.py
stage_check.py
# PowerShell artifact — `> nul` redirection accidentally creates a literal file
# named "nul" on Windows (even though "nul" is reserved). Ignore it.
nul

# Bash wrapper for cron / manual runs (sibling scripts in the Hermes-agent flow)
run_*.sh
